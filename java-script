function toggleTugas(button) {
    let tugas = button.nextElementSibling;

    if (tugas.style.display === "none" || tugas.style.display === "") {
        tugas.style.display = "block";
        button.innerText = "Sembunyikan Tupoksi";
    } else {
        tugas.style.display = "none";
        button.innerText = "Lihat Tupoksi";
    }
}
