/* RESET */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Arial', sans-serif;
}

/* BODY */
body {
    background: #f5f7fb;
    color: #333;
    line-height: 1.6;
}

/* HEADER */
header {
    background: #0d47a1;
    color: white;
    padding: 20px;
    text-align: center;
}

/* NAVBAR */
nav {
    margin-top: 10px;
}

nav ul {
    display: flex;
    justify-content: center;
    list-style: none;
    gap: 20px;
    flex-wrap: wrap;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

nav ul li a:hover {
    color: #ffeb3b;
}

/* HERO SECTION */
.hero {
    background: linear-gradient(135deg, #1976d2, #42a5f5);
    color: white;
    text-align: center;
    padding: 80px 20px;
}

.hero h2 {
    font-size: 32px;
    margin-bottom: 10px;
}

.hero p {
    font-size: 18px;
    opacity: 0.9;
}

.hero button {
    margin-top: 20px;
    padding: 12px 20px;
    border: none;
    background: white;
    color: #1976d2;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
    transition: 0.3s;
}

.hero button:hover {
    background: #e3f2fd;
}

/* SECTION */
section {
    padding: 40px 20px;
}

/* CARD */
.card {
    background: white;
    padding: 20px;
    margin-top: 15px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

/* GRID UNTUK PROGRAM / PENGURUS */
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

/* FOOTER */
footer {
    background: #0d47a1;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 40px;
}

/* RESPONSIVE */
@media (max-width: 768px) {
    .hero h2 {
        font-size: 24px;
    }

    nav ul {
        flex-direction: column;
        align-items: center;
    }
}
